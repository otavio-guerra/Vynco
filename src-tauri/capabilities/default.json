{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "A barra da janela é do Vynco: o painel (servidor local em 127.0.0.1) só pode arrastar, minimizar, maximizar e fechar a janela. Nenhuma outra API do Tauri fica disponível para a página.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-set-decorations"
  ]
}