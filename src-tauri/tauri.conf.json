{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vynco",
  "version": "../package.json",
  "identifier": "app.vynco.desktop",
  "build": {
    "frontendDist": "../app/desktop/janela",
    "devUrl": "http://127.0.0.1:4800",
    "beforeDevCommand": { "script": "npm start", "wait": false }
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Otavio Guerra",
    "copyright": "MIT",
    "category": "Productivity",
    "shortDescription": "Vynco: sua carreira em outro nível. Posts no LinkedIn feitos pela sua IA e aprovados por você",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/vynco-node"],
    "resources": {
      "../app/server.js": "vynco/app/server.js",
      "../app/public/": "vynco/app/public/",
      "../app/desktop/backend.js": "vynco/app/desktop/backend.js",
      "../engine/": "vynco/engine/",
      "../prompts/": "vynco/prompts/",
      "../agent/": "vynco/agent/",
      "../examples/": "vynco/examples/",
      "../package.json": "vynco/package.json",
      "../LICENSE": "vynco/LICENSE"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
